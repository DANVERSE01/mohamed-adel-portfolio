# AI Providers
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_REPLICATE_API_KEY=your_replicate_api_key_here
VITE_CLOUDFLARE_WORKER_URL=https://your-worker.workers.dev

# Analytics
VITE_ANALYTICS_ENDPOINT=https://your-analytics-endpoint.com/api/events
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# CDN (Optional)
